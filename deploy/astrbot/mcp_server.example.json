{
  "mcpServers": {
    "maimai-local-search": {
      "active": true,
      "command": "python",
      "args": [
        "-m",
        "maimai_mcp.server"
      ],
      "cwd": "/AstrBot/data/maimai-mcp"
    },
    "diving-fish-b50": {
      "active": true,
      "command": "python",
      "args": [
        "-m",
        "diving_fish_b50_mcp.server"
      ],
      "cwd": "/AstrBot/data/maimai-mcp",
      "env": {
        "DIVING_FISH_MCP_TOKEN_FILE": "/AstrBot/data/maimai-config/.diving-fish-mcp-secrets.json",
        "MAIMAI_LOCAL_SEARCH_MCP_ARGS": "[\"-m\", \"maimai_mcp.server\"]",
        "MAIMAI_LOCAL_SEARCH_MCP_CWD": "/AstrBot/data/maimai-mcp",
        "PLAYER_CACHE_DIR": "/AstrBot/data/player-cache",
        "QQ_IDENTITY_CACHE_DIR": "/AstrBot/data/qq-identity-cache"
      }
    },
    "group-b50": {
      "active": true,
      "command": "python",
      "args": [
        "-m",
        "group_b50_mcp.server"
      ],
      "cwd": "/AstrBot/data/maimai-mcp",
