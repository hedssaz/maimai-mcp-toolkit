        "GROUP_SONG_CACHE_DIR": "/AstrBot/data/group-song-cache",
        "MAIMAI_LOCAL_SEARCH_MCP_ARGS": "[\"-m\", \"maimai_mcp.server\"]",
        "MAIMAI_LOCAL_SEARCH_MCP_CWD": "/AstrBot/data/maimai-mcp",
        "NAPCAT_BASE_URL": "http://napcat:3000",
        "PLAYER_CACHE_DIR": "/AstrBot/data/player-cache",
        "QQ_IDENTITY_CACHE_DIR": "/AstrBot/data/qq-identity-cache"
      }
    },
    "qq-identity": {
