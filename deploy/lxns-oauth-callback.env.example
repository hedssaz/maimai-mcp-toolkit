# 必填。使用 `openssl rand -hex 32` 生成，并与 Bot 轮询配置保持一致。
LXNS_CALLBACK_TOKEN=

# 回调桥只监听本机，由 HTTPS 反向代理对外提供 callback/poll 路径。
LXNS_CALLBACK_HOST=127.0.0.1
LXNS_CALLBACK_PORT=8788
LXNS_CALLBACK_PATH=/lxns/callback
LXNS_CALLBACK_POLL_PATH=/lxns/poll
LXNS_CALLBACK_TTL_SECONDS=600
LXNS_CALLBACK_DB=/var/lib/lxns-oauth-callback/callbacks.sqlite3
