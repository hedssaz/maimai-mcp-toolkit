          },
          "ttlSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800,
            "description": "待确认有效期，默认 300 秒。"
          }
        },
        "required": [
          "qq",
          "code",
          "adapterId",
          "groupId",
          "botQq"
        ],
        "additionalProperties": false
      }
    },
    {
