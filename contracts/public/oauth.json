        ],
        "additionalProperties": false
      }
    },
    {
      "name": "maimai_lxns_unbind",
      "description": "删除该 subject 的 OAuth token、state 和待确认记录。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "qq": {
