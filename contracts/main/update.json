          "state",
          "adapterId",
          "groupId",
          "botQq"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "maimai_lxns_confirm_poke",
      "description": "Direct-only: atomically confirm a staged LXNS OAuth binding from the original QQ poke context.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string"
          },
          "adapterId": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
