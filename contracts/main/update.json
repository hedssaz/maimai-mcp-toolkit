      "inputSchema": {
        "type": "object",
        "properties": {
          "qq": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "timeout": {
            "type": "number"
          }
        },
        "required": [
          "qq",
          "code"
        ],
        "additionalProperties": false
      }
    },
