          "state": {
            "type": "string"
          },
          "adapterId": {
            "type": "string"
          },
          "groupId": {
            "type": "string"
          },
          "botQq": {
            "type": "string"
          },
          "ttlSeconds": {
            "type": "integer"
          },
          "timeout": {
            "type": "number"
          }
